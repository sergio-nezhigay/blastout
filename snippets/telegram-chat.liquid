
{% if settings.tg_chat_enable %}
  <div
    class="tg-chat"
    style="
      --tg-chat-bottom: {{ settings.tg_chat_offset_bottom | default: 20 }}px;
      --tg-chat-right: {{ settings.tg_chat_offset_right | default: 20 }}px;
      --tg-chat-fab-bg: {{ settings.tg_chat_fab_bg | default: '#7A5A00' }};
    "
    data-tg-chat
  >
    <button
      type="button"
      class="tg-chat__fab"
      aria-label="Open Telegram manager link"
      aria-expanded="false"
      data-tg-chat-toggle
    >
      {% if settings.tg_chat_icon != blank %}
        <img
          class="tg-chat__icon-img"
          src="{{ settings.tg_chat_icon | image_url: width: 128 }}"
          alt=""
          loading="lazy"
          width="64"
          height="64"
        >
      {% else %}
        <svg class="tg-chat__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 2H4a2 2 0 0 0-2 2v15.2A2.8 2.8 0 0 0 4.8 22H6v-2H4.8a.8.8 0 0 1-.8-.8V4h16v9h2V4a2 2 0 0 0-2-2Z"/>
          <path d="M8 7h8v2H8V7Zm0 4h8v2H8v-2Zm0 4h5v2H8v-2Z"/>
        </svg>
      {% endif %}
    </button>

    <a
      class="tg-chat__panel"
      href="{{ settings.tg_chat_link | escape }}"
      target="_blank"
      rel="noopener"
      data-tg-chat-panel
    >
      <span class="tg-chat__text">
        {{ settings.tg_chat_text | default: 'Написати менеджеру в телеграм' | escape }}
      </span>

      <span class="tg-chat__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M5 19L19 5M9 5h10v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
    </a>
  </div>

  <style>
    .tg-chat{
      position: fixed;
      right: var(--tg-chat-right, 20px);
      bottom: var(--tg-chat-bottom, 20px);
      z-index: 3;
      pointer-events: none;
      width: 64px;
      height: 64px;
    }

    .tg-chat__fab,
    .tg-chat__panel{ pointer-events: auto; }

    .tg-chat__fab{
      width: 64px;
      height: 64px;
      border-radius: 999px;
      border: 0;
      cursor: pointer;
      display: grid;
      place-items: center;
      box-shadow: 0 10px 30px rgba(0,0,0,.18);

     
      background: transparent;

      padding: 0;
      overflow: hidden;

      transition: transform .2s ease, box-shadow .2s ease;

      position: relative;
      z-index: 2; 
    }

    .tg-chat__fab:hover{
      transform: translateY(-1px);
      box-shadow: 0 12px 34px rgba(0,0,0,.22);
    }

  
    .tg-chat__icon-img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 999px;
    }

   
    .tg-chat__icon-svg{
      width: 100%;
      height: 100%;
      fill: #fff;
      opacity: .95;
    }

    .tg-chat__panel{
      position: absolute;
      right: 3px;
      bottom: 4px;
      z-index: 1; 

      transform-origin: right center;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1px;

      text-decoration: none;
      border-radius: 34px;

      padding: 12px calc(64px + 14px) 12px 20px;

      background: #111;
      color: #fff;
      box-shadow: 0 10px 30px rgba(0,0,0,.20);

      width: 300px;
      max-width: 300px;
      white-space: normal;
      line-height: 1.2;

      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(8px) scaleX(0);
      transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
    }

    .tg-chat.is-open .tg-chat__panel{
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0) scaleX(1);
    }

    .tg-chat__text{
      display: block;
      font-size: 14px;
      font-weight: 600;
      max-width: 220px;
    }

    .tg-chat__arrow{
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      opacity: .95;
    }

    .tg-chat__arrow svg{
      width: 22px;
      height: 22px;
      color: #fff;


      transform-origin: center;
    }

    @keyframes tg-wiggle{
      0% { transform: translateX(0) rotate(0); }
      20% { transform: translateX(-2px) rotate(-2deg); }
      40% { transform: translateX(2px) rotate(2deg); }
      60% { transform: translateX(-1px) rotate(-1deg); }
      80% { transform: translateX(1px) rotate(1deg); }
      100% { transform: translateX(0) rotate(0); }
    }

    .tg-chat__fab.is-wiggle{
      animation: tg-wiggle .45s ease-in-out 1;
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-tg-chat]');
      if (!root) return;

      var toggle = root.querySelector('[data-tg-chat-toggle]');
      var panel  = root.querySelector('[data-tg-chat-panel]');
      if (!toggle || !panel) return;

      function setOpen(open) {
        root.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        var isOpen = root.classList.contains('is-open');
        setOpen(!isOpen);
      });

      document.addEventListener('click', function (e) {
        if (!root.classList.contains('is-open')) return;
        if (root.contains(e.target)) return;
        setOpen(false);
      });

      function scheduleWiggle() {
        var delay = 5000 + Math.floor(Math.random() * 1000);
        setTimeout(function () {
          toggle.classList.add('is-wiggle');
          setTimeout(function () { toggle.classList.remove('is-wiggle'); }, 700);
          scheduleWiggle();
        }, delay);
      }
      scheduleWiggle();
    })();
  </script>
{% endif %}
