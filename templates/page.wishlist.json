      "name": "currency",
      "settings": {
        "custom_liquid": "{% if request.page_type == 'page' and page.handle == 'wishlist' %}\n  <script>\n    (function () {\n \n      var currencySymbol = {{ localization.country.currency.symbol | default: cart.currency.symbol | json }};\n      var currencyCode   = {{ localization.country.currency.iso_code | default: cart.currency.iso_code | json }};\n      var suffix = (currencySymbol && currencySymbol.trim()) ? currencySymbol : currencyCode;\n\n      function injectCurrency(root) {\n        (root || document).querySelectorAll('p.st-js-price').forEach(function (p) {\n          if (p.querySelector('.st-currency')) return; \n\n          var cur = document.createElement('span');\n          cur.className = 'st-currency';\n          cur.textContent = '\\u00A0' + suffix; \n\n          var compare = p.querySelector('.st-js-compare-at-price');\n          if (compare) p.insertBefore(cur, compare);\n          else p.appendChild(cur);\n        });\n      }\n\n      // первый прогон\n      injectCurrency();\n\n    \n      var obs = new MutationObserver(function (mutations) {\n        for (var i = 0; i < mutations.length; i++) {\n          for (var j = 0; j < mutations[i].addedNodes.length; j++) {\n            var node = mutations[i].addedNodes[j];\n            if (node && node.nodeType === 1) {\n              if (node.matches('p.st-js-price') || node.querySelector('p.st-js-price')) {\n                injectCurrency();\n                return;\n              }\n            }\n          }\n        }\n      });\n\n      obs.observe(document.body, { childList: true, subtree: true });\n    })();\n  </script>\n\n  <style>\n    .st-currency { font: inherit; }\n  </style>\n{% endif %}",
        "section_width": "max-w-page",
